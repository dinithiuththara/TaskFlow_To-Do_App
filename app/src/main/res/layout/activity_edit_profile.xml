<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/splash_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="30dp">

        <ImageView
            android:id="@+id/btnBackEdit"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_marginTop="30dp"
            android:layout_marginStart="25dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#000000" />

        <TextView
            android:id="@+id/txtEditTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="70dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/editProfileImg"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/your_photo"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="#FFEB3B"
            app:strokeWidth="2dp"
            app:layout_constraintTop_toTopOf="@id/txtEditTitle"
            app:layout_constraintBottom_toBottomOf="@id/txtEditTitle"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="20dp" />

        <TextView
            android:id="@+id/lblEditName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FULL NAME"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintTop_toBottomOf="@id/txtEditTitle"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="45dp"
            android:layout_marginTop="40dp" />

        <EditText
            android:id="@+id/etEditFullName"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:background="@drawable/rounded_input_white"
            android:paddingStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/lblEditName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/lblEditUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USERNAME"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintTop_toBottomOf="@id/etEditFullName"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="45dp"
            android:layout_marginTop="15dp" />

        <EditText
            android:id="@+id/etEditUsername"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:background="@drawable/rounded_input_white"
            android:paddingStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/lblEditUsername"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/lblEditEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMAIL ADDRESS"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintTop_toBottomOf="@id/etEditUsername"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="45dp"
            android:layout_marginTop="15dp" />

        <EditText
            android:id="@+id/etEditEmail"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:background="@drawable/rounded_input_white"
            android:paddingStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/lblEditEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/lblEditPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHONE NUMBER"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_bold"
            app:layout_constraintTop_toBottomOf="@id/etEditEmail"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="45dp"
            android:layout_marginTop="15dp" />

        <EditText
            android:id="@+id/etEditPhone"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:background="@drawable/rounded_input_white"
            android:paddingStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/lblEditPhone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="5dp" />

        <Button
            android:id="@+id/btnSaveChanges"
            android:layout_width="320dp"
            android:layout_height="55dp"
            android:text="Save Changes"
            android:backgroundTint="#FF8C00"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/poppins_bold"
            android:textAllCaps="false"
            app:cornerRadius="15dp"
            app:layout_constraintTop_toBottomOf="@id/etEditPhone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="40dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>